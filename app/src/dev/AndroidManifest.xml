<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        KeepDnsVpnService and its FOREGROUND_SERVICE / FOREGROUND_SERVICE_SPECIAL_USE /
        ACCESS_NETWORK_STATE permissions moved to app/src/main/AndroidManifest.xml when
        website blocking shipped to prod. The dev flavor inherits them through manifest
        merge, so redeclaring them here would only create drift.

        What stays dev-only is the spike entry point: KeepDnsVpnSpikeActivity's source
        lives in app/src/dev/java and drives the adb start/stop commands the runbook uses
        for the two manual regression checks that cannot be automated (revoking VPN consent
        from settings, and another app taking the VPN slot).
        See docs/WEBSITE_BLOCKING_VPN_SPIKE.md.
    -->
    <application>
        <activity
            android:name=".websiteblocking.KeepDnsVpnSpikeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Keep" />
    </application>
</manifest>
